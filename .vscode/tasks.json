{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install backend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Install Company portal dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install Super Admin dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install all dependencies",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install backend dependencies",
        "Install Company portal dependencies",
        "Install Super Admin dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run backend",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run database tunnel",
      "type": "shell",
      "command": "ssh -N -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes -L 15432:127.0.0.1:5433 -L 18082:127.0.0.1:8082 root@134.122.92.105",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Company portal",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Super Admin portal",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5174",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start application servers",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Run backend",
        "Run Company portal",
        "Run Super Admin portal"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start all local servers",
      "dependsOrder": "parallel",
      "runOptions": { "runOn": "folderOpen" },
      "dependsOn": [
        "Run database tunnel",
        "Start application servers"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test Super Admin",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build Company portal",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build Super Admin portal",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build both portals",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Company portal",
        "Build Super Admin portal"
      ],
      "problemMatcher": []
    }
  ]
}
